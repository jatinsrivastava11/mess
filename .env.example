# Copy to .env.local and fill in. Never commit .env.local.

# --- Local development with the Firebase emulators (npm run dev:online) ---
# "demo-" project IDs only work against the emulators, never real Firebase.
NEXT_PUBLIC_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-mess.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-mess
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app

# --- Real Firebase project (production / Vercel) ---
# The NEXT_PUBLIC_ values come from Firebase console → Project settings → Your apps (web app config).
# They are public by design; security comes from firestore.rules and the API routes.
# NEXT_PUBLIC_FIREBASE_EMULATORS=false
#
# SECRET: Admin SDK service account (Project settings → Service accounts → Generate new private key),
# pasted as ONE line of JSON. Server-only: never prefix with NEXT_PUBLIC_, never commit it.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

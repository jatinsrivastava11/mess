rules_version = '2';

// Browsers may only READ. Every write (games, usernames, wins) goes through the
// Next.js API routes, which check it first and write with the Admin SDK (which
// bypasses these rules). So nobody can edit a game or give themselves wins.
service cloud.firestore {
  match /databases/{database}/documents {
    // A game is visible only to its two players.
    match /games/{code} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.players.w || request.auth.uid == resource.data.players.b);
      allow write: if false;
    }

    // Public profile: username and wins only (never email). Anyone signed in may view one.
    match /users/{uid} {
      allow get: if request.auth != null;
      allow list, write: if false;
    }

    // Username → owner index. Server only.
    match /usernames/{name} {
      allow read, write: if false;
    }

    // Anything not listed above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

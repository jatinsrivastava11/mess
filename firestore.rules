rules_version = '2';

// Browsers may only READ games they are playing in. Every write (create, join,
// move, resign) goes through the Next.js API routes, which check the move with
// the game engine and write using the Admin SDK (which bypasses these rules).
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{code} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.players.w || request.auth.uid == resource.data.players.b);
      allow write: if false;
    }

    // Anything not listed above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
